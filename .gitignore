node_modules/
.pnpm-store/

# 前端产物
dist/
dist-ssr/
*.local

# Rust 产物
src-tauri/target/
**/*.rs.bk

# Tauri 生成物
src-tauri/gen/schemas/

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 测试覆盖率
coverage/

# 本地个人稿库（绝不入库）
/vault/

# 示例稿库里跑应用会生成运行时产物（写作统计、回收站），不该入库。
# 示例库本身要入库：三个端到端测试与 ui-check 都依赖它。
examples/**/.qinglai/
examples/**/.trash/

# 工作区记忆与本地会话数据：每次会话都会变，不该进版本控制
.workbuddy-ai/
